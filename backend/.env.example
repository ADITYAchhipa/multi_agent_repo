APP_ENV=development
DEMO_MODE=true
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=16379
FALKORDB_GRAPH=company_demo
TENANT_GRAPHS={"tenant-demo":"company_demo"}
FALKORDB_TLS=false
# FALKORDB_PASSWORD=replace-with-runtime-secret
FALKORDB_QUERY_TIMEOUT_MS=2000
FALKORDB_SOCKET_TIMEOUT_SECONDS=3
FRONTEND_ORIGINS=["http://localhost:3000"]
DEBUG_DOCS=false
# Optional local-demo sessions; configure both values before using product routes.
# DEMO_USERS={"actor-viewer":{"credential":"replace-with-local-secret","tenant_id":"tenant-demo","roles":["viewer"]}}
# SESSION_SECRET=replace-with-at-least-32-random-characters
# SOURCE_STORAGE_ROOT=data/sources
# SIGNING_PRIVATE_KEY_PATH=secrets/runtime-signing.pem
# SIGNING_KEY_ID=key-1
# SIGNING_ISSUER_ID=promiseops-demo
# Public verification keys only; never put private keys here.
# PUBLIC_KEYS=[{"tenant_id":"tenant-demo","issuer_id":"promiseops-demo","key_id":"key-1","public_key_base64url":"replace-with-public-key","trust":"TRUSTED"}]
